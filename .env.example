# Akidoro Local Frontend Configuration

# The URL of your Supabase project (e.g., https://xyz.supabase.co)
VITE_SUPABASE_URL=

# The public anon key for your Supabase project
VITE_SUPABASE_PUBLISHABLE_KEY=

# Note: All Edge Function secrets (RESEND_API_KEY, SMTP_HOST, UNSUBSCRIBE_SECRET, MAIL_FROM)
# must be set in your Supabase project using the CLI or Dashboard, not in this file.
# e.g.: supabase secrets set RESEND_API_KEY=your-key
